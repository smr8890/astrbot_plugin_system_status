{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "key": {
      "type": "both"
      // "paddingLeft": 4
    }
  },
  "modules": [
    {
      "key": "(#6670F6)OS",
      "keyColor": "#6670F6",
      "type": "os"
    },
    {
      "key": "(#6640F6)内核",
      "keyColor": "#6640F6",
      "type": "kernel"
    },
    {
      "key": "(#45BC83)运行时间",
      "keyColor": "#45BC83",
      "type": "uptime"
    },
    {
      "key": "(#95959B)CPU",
      "keyColor": "#95959B",
      "type": "cpu"
    },
    {
      "key": "(#788760)内存 {}",
      "keyColor": "#788760",
      "type": "physicalmemory"
    },
    {
      "key": "(#F4A460)包",
      "keyColor": "#F4A460",
      "type": "packages"
    },
    {
      "key": "(#82df0e)主机",
      "keyColor": "#82df0e",
      "type": "host"
    },
    {
      "key": "(#20B2AA)Shell",
      "keyColor": "#20B2AA",
      "type": "shell"
    },
    {
      "key": "(#FF69B4)分辨率",
      "keyColor": "#FF69B4",
      "type": "display"
    }
  ]
}